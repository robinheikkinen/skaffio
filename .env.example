# Kopiera till .env och anpassa
COMPOSE_PROJECT_NAME=fridgely

# ─── Auth ────────────────────────────────────────────────────────
# 32+ tecken slumpmässig sträng — används för att signera JWT-tokens.
# Lämna tomt så genererar backend en automatiskt vid första start
# (sparas i volymen /data/.jwt-secret). Sätt explicit för att kunna
# rota / återanvända tokens mellan miljöer.
JWT_SECRET=

# När första användaren har registrerat sig (blir admin automatiskt)
# styr denna om fler får skapa egna konton via /register, eller om
# enbart admin får skapa konton via /api/auth/users.
# true  = öppen registrering
# false = enbart admin-skapade konton (rekommenderat efter bootstrap)
ALLOW_REGISTRATION=true

# ─── AI (moln) ───────────────────────────────────────────────────
# OpenAI-kompatibelt API. Funkar med Staik, OpenAI, Anthropic, Mistral, Groq m.fl.
# Exempel:
#   Staik:     AI_API_URL=https://api.staik.se/v1
#   OpenAI:    AI_API_URL=https://api.openai.com/v1
#   Anthropic: AI_API_URL=https://api.anthropic.com/v1   (OpenAI-compat layer)
AI_API_URL=https://api.staik.se/v1
AI_API_KEY=sk-st-...
# Modellnamn — kolla din leverantörs dashboard för exakta IDs.
AI_MODEL=gpt-4o-mini
# Vision-modell. Kan vara samma som AI_MODEL om den är multimodal.
AI_VISION_MODEL=gpt-4o-mini

# ─── Anthropic (Claude native) ──────────────────────────────────
# Används för PDF-extraktion där andra modeller hallucinerar.
# Hämta nyckel från https://console.anthropic.com/settings/keys
# Lämna ANTHROPIC_API_KEY tomt → PDF-AI-extraktion stängs av (text + bilder
# returneras ändå, användaren får fylla i recept manuellt).
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Home Assistant (valfritt) ───────────────────────────────────
# Långlivad åtkomsttoken från HA → Profil → Säkerhet.
# Helper-entiteter ska innehålla "frys_1", "frys_2", "kyl_1" eller "kyl_2"
# i entity_id eller friendly_name, och vara "on"/"in_stock" när varan finns.
# Lämna HASS_TOKEN tomt för att inaktivera HA-integration (appen fungerar ändå).
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=

# Webhook ID i HA som tar emot freezer_portion_added/consumed-event från Fridgely.
# Skapa en automation i HA med trigger "webhook" och denna ID. Lämna tomt = ingen sync.
HASS_FREEZER_WEBHOOK=fridgely_freezer

# Discord webhook för säkerhetshändelser (account lockout, ny registrering, etc.)
# Skapa: Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL
# Lämna tomt = inga Discord-notiser. Appen fungerar oförändrat.
DISCORD_WEBHOOK_URL=

# Cloudflare Access auto-login (Google SSO via edge)
# CF_TRUST_HEADERS=true → appen läser Cf-Access-Authenticated-User-Email
# och loggar in användaren automatiskt om CF Access släppt igenom.
# Sätt false om du vill kräva lokalt password istället för CF-headers.
CF_TRUST_HEADERS=true

# Calendar entity för förskolans matsedel — t.ex. calendar.forskolan_matsedel
# (om den är synkad till HA via Google Calendar/CalDAV-integration).
# Visas på MealPlan-sidan så man slipper äta samma mat hemma. Lämna tomt = av.
HASS_PRESCHOOL_CALENDAR=

# DIREKT mot skolmaten.se — kräver INGET HA.
# Klistra in din förskolas URL från skolmaten.se, t.ex.:
#   SCHOOL_MENU_URL=https://skolmaten.se/forskolan-akersberga
# (Hitta din genom att söka på skolmaten.se → kopiera URL:n.)
# Om både denna OCH HASS_PRESCHOOL_CALENDAR är satta — denna vinner.
SCHOOL_MENU_URL=

# Visningsnamn för förskolan i UI (annars deriveras från slug).
# Sätt detta för att få korrekt svenska tecken (Äventyret istället för Aventyret2).
SCHOOL_DISPLAY_NAME=
